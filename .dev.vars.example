# Examples below are placeholders and are intentionally rejected by runtime validation.
# Generate each required secret independently, for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Or create ready-to-use local files (gitignored) with:
#   node scripts/ensure-local-secrets.mjs
SESSION_SECRET=replace-with-a-local-development-secret-at-least-32-characters
# AUTH_ENCRYPTION_KEY=<optional-32-byte-base64url-key-for-totp>
# ANALYTICS_REPORT_TOKEN=<optional-third-party-report-api-token>
# UMAMI_API_TOKEN=<optional-umami-cloud-api-key>
# UMAMI_SELF_HOSTED_CREDENTIAL={"apiBaseUrl":"https://umami.example.com/api","token":"<self-hosted-bearer-token>"}
# PLAUSIBLE_API_KEY=<optional-plausible-stats-api-key>
# ALGOLIA_ADMIN_KEY=<optional-algolia-admin-api-key-for-search-management>
# OPENAI_API_KEY=<optional-openai-api-key-for-comment-moderation>
# S3-compatible media storage (AWS S3, MinIO, Aliyun OSS, Tencent COS, Backblaze B2, R2's S3 API).
# Endpoint/region/bucket are non-secret and configured under Settings → Media → Integrations.
# S3_ACCESS_KEY_ID=<optional-s3-access-key-id>
# S3_SECRET_ACCESS_KEY=<optional-s3-secret-access-key>
# S3_SESSION_TOKEN=<only-for-sts-issued-temporary-credentials>
# D1 is not a secret. Keep the DB binding in wrangler.jsonc.
